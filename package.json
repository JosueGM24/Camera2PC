{
  "name": "camera2pc",
  "version": "1.1.0",
  "private": true,
  "description": "La camara del telefono en la PC y la pantalla de la PC en la tablet, via WebRTC (Wi-Fi o cable USB)",
  "type": "module",
  "scripts": {
    "build": "node scripts/build-config.mjs",
    "dev": "node scripts/build-config.mjs && npx --yes netlify-cli dev",
    "local": "node scripts/build-config.mjs && node scripts/local-server.mjs",
    "usb": "powershell -ExecutionPolicy Bypass -File scripts/usb-android.ps1"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@netlify/blobs": "^10.7.11"
  }
}
